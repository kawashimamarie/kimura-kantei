{
  "name": "kimura-kantei-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:pages": "PREVIEW_BASE=/kimura-kantei EXCLUDE_SAMPLES=1 EXCLUDE_COMPARE=1 PREVIEW_TOOLS=1 node scripts/build-pages.mjs",
    "fonts:setup": "python3 -m venv .venv-fonts && .venv-fonts/bin/pip install -q -r fonts/requirements.txt",
    "fonts:fetch": "node scripts/fonts/cli.mjs fetch",
    "fonts:collect": "node scripts/fonts/cli.mjs collect",
    "fonts:subset": "node scripts/fonts/cli.mjs subset",
    "fonts:update": "node scripts/fonts/cli.mjs update",
    "fonts:check": "node scripts/fonts/cli.mjs check",
    "fonts:stats": "node scripts/fonts/cli.mjs stats",
    "fonts:doctor": "node scripts/fonts/cli.mjs doctor",
    "build:production": "astro build && node scripts/check-production.mjs"
  },
  "dependencies": {
    "astro": "7.3.6"
  },
  "devDependencies": {
    "budoux": "^0.10.0",
    "parse5": "^7.3.0",
    "playwright-core": "1.56.1"
  }
}
