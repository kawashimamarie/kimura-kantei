---
// ご相談の流れ（現行サイト「お問合せ」ページの流れを整理したもの）
// example には、そのページのテーマに合った「最初のひと言」の例を渡す。
interface Props { example?: string }
const { example } = Astro.props;
const first = example
  ? `お電話またはメールでご予約ください。「${example}」など、ご用件を一言お伝えいただければ十分です。`
  : 'お電話またはメールでご予約ください。「相続した不動産のこと」「地代のこと」など、ご相談のテーマを一言お伝えいただければ十分です。';
const steps = [
  { name: 'ご予約', text: first },
  { name: '無料相談', text: 'ご来社・ご訪問・Zoomで、状況を伺い、問題点を整理します。' },
  { name: 'お見積り', text: '必要な調査の内容と費用をお伝えします。ここまでは無料です。' },
  { name: '調査・評価', text: 'ご依頼をいただいてから、現地調査や資料の調査を行います。' },
  { name: 'ご報告・書面の発行', text: '結果をご説明し、書面を発行します。その後のご相談にも対応します。' },
];
---
<ol class="flow">
  {steps.map((s, i) => (
    <li class="flow__step">
      <span class="flow__num" aria-hidden="true">{i + 1}</span>
      <h3 class="flow__name">{s.name}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
