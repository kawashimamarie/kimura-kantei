---
// ご相談の流れ（現行デザイン）。文言は data/flow.ts に集約。
import { flowSteps } from '../data/flow';
interface Props { example?: string }
const { example } = Astro.props;
const steps = flowSteps(example);
---
<ol class="flow">
  {steps.map((s, i) => (
    <li class="flow__step">
      <span class="flow__num" aria-hidden="true">{i + 1}</span>
      <h3 class="flow__name">{s.name}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
