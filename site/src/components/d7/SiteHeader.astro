---
// D7 共通ヘッダー。上部に固定（SPは下スクロールで隠れ、上スクロールで現れる）。1199px以下は MENU ボタンで nav・電話・申込ボタンのパネルを開閉する（処理は SiteLayout のスクリプト）。
import { nav, contact, site } from '../../data/site';
import { u } from '../../lib/url';

interface Props { path: string }
const { path } = Astro.props;
---
<header class="hd">
  <div class="hd__in">
    <a class="logo" href={u('/')} aria-label={`${site.name} トップページ`}>
      <img src={u('/assets/img/logo/kimura-logo.png')} width="230" height="168" alt="">
      <span class="logo__name">{site.name}<small>{site.tagline}</small></span>
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="global-nav"><span class="menu__label">MENU</span></button>
    <div class="hd__panel" id="global-nav">
      <nav class="nav" aria-label="メインメニュー">
        {nav.map((item) => <a href={u(item.href)} aria-current={path === item.href || path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <a class="hd__tel" href={contact.telHref}><b>{contact.tel}</b><span>受付 {contact.hours}</span></a>
      <a class="hd__cta" href={u('/contact/')}>相談を申し込む</a>
    </div>
  </div>
</header>
