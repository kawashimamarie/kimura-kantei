---
import '../styles/d7/info.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/d7/PageHero.astro';
import FlowList from '../components/d7/FlowList.astro';
import { ctaPoints } from '../data/cta';
import { contact } from '../data/site';
import { u } from '../lib/url';

const mailBody = [
  'お名前：',
  'ご連絡先（電話番号）：',
  'ご希望の連絡方法（メール／電話／ご来社）：',
  'ご相談の内容（わかる範囲で構いません）：',
  '',
].join('\n');
const crumbs = [{ name: 'お問い合わせ', path: '/contact/' }];
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent('ご相談のお申し込み')}&body=${encodeURIComponent(mailBody)}`;
---
<SiteLayout
  title="お問い合わせ・ご相談"
  description="木村不動産鑑定へのお問い合わせ・ご相談の方法です。初回のご相談は無料。お電話（03-5356-9158）またはメールでご予約ください。ご来社・ご訪問・Zoomでのご相談に対応します。JR中央線「阿佐ヶ谷」駅から徒歩1分。"
  path="/contact/"
  breadcrumbs={[{ name: 'お問い合わせ', path: '/contact/' }]}
  spbarMain={{ label: 'メールで申し込む', href: mailto }}
>
  <PageHero title="お問い合わせ・ご相談" lead="「こんなことを相談していいのかな」という段階でも大丈夫です。初回のご相談は無料です。お電話またはメールで、お気軽にご予約ください。" crumbs={crumbs} />

  <section class="sec sec--tight sec--reach" aria-labelledby="ways-title">
    <div class="wrap">
      <h2 class="u-visually-hidden" id="ways-title">お問い合わせの方法</h2>
      <div class="reach">
        <div class="reach__col reveal">
          <p class="kicker">お電話</p>
          <a class="reach__tel" href={contact.telHref}>{contact.tel}</a>
          <p class="reach__hours">営業時間 {contact.hours}</p>
          <p class="reach__t">「〇〇のことで相談したい」とお伝えください。ご相談の日時を決めさせていただきます。</p>
        </div>
        <div class="reach__col reveal" data-delay="1">
          <p class="kicker">メール</p>
          <a class="reach__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
          <p class="reach__t">お名前・ご連絡先・ご相談の内容（わかる範囲で構いません）をお書き添えください。当社からご返信します。</p>
          <a class="btn" href={mailto}>メールで申し込む<i aria-hidden="true">→</i></a>
        </div>
      </div>
      <ul class="points">{ctaPoints.map((t) => <li>{t}</li>)}</ul>
    </div>
  </section>

  <section class="sec sec--paper" id="flow" aria-labelledby="flow-title">
    <div class="wrap split">
      <div class="split__head reveal">
        <h2 class="h2" id="flow-title">ご相談の流れ</h2>
        <p class="lead">ご予約からお見積りまでは無料です。お見積りの内容をご確認いただいてから、ご依頼いただくかどうかをお決めください。</p>
      </div>
      <FlowList />
    </div>
  </section>

  <section class="sec" aria-labelledby="access-title">
    <div class="wrap">
      <div class="reveal sechead"><h2 class="h2" id="access-title">事務所へのアクセス</h2></div>
      <div class="access reveal">
        <figure><img src={u('/assets/img/office/office-meeting.jpg')} width="1200" height="900" alt="事務所内の相談スペース" loading="lazy" decoding="async"></figure>
        <div>
          <p class="access__a">{contact.access}<small>{contact.accessSub}</small></p>
          <address>〒{contact.postalCode}<br>{contact.address}</address>
          <a class="btn btn--line" href={contact.mapUrl} target="_blank" rel="noopener">地図を開く（Google マップ）<i aria-hidden="true">→</i></a>
        </div>
      </div>
      <p class="more"><a class="u-link" href={u('/faq/')}>よくあるご質問を見る</a></p>
    </div>
  </section>
</SiteLayout>
