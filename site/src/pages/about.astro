---
import '../styles/d7/info.css';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/d7/PageHero.astro';
import PageNav from '../components/d7/PageNav.astro';
import ExpertBox from '../components/d7/ExpertBox.astro';
import CtaD7 from '../components/d7/CtaD7.astro';
import { site, contact, company } from '../data/site';
import { u } from '../lib/url';
const crumbs = [{ name: '会社案内', path: '/about/' }];
---
<SiteLayout
  title="木村不動産鑑定について（会社案内・アクセス）"
  description="株式会社木村不動産鑑定の会社案内。2006年に東京・阿佐ヶ谷で創業。不動産鑑定業者・一級建築士事務所・宅地建物取引業者・東京都木造住宅耐震診断事務所として、不動産の価格と建物の両面からご相談に応じています。JR中央線「阿佐ヶ谷」駅から徒歩1分。"
  path="/about/"
  breadcrumbs={[{ name: '会社案内', path: '/about/' }]}
>
  <PageHero title="木村不動産鑑定について" lead="2006年に東京・阿佐ヶ谷で創業して以来、不動産鑑定を中心に、建物診断、不動産の売買の仲介、相続に関わるご相談に携わってきました。" crumbs={crumbs} />
  <PageNav items={[
    { id: 'message', label: 'ごあいさつ' },
    { id: 'strength', label: 'ひとつの事務所で、価格から建物まで' },
    { id: 'overview', label: '会社概要' },
    { id: 'access', label: 'アクセス' },
  ]} />

  <section class="sec" id="message" aria-labelledby="message-title">
    <div class="wrap">
      <div class="greet">
        <div class="reveal">
          <h2 class="h2" id="message-title" style="margin-bottom:28px">ごあいさつ</h2>
          <div class="prose">
            <p>当社は平成18年（2006年）に、杉並区阿佐ヶ谷で不動産鑑定事務所として設立されました。その後、不動産鑑定を中心に、建物診断、不動産仲介、相続に関わる相談業務に携わってきました。</p>
            <p>事業環境や不動産市場は常に変化していますが、専門職業家としてたゆまず努力し、研鑽することが社会的な使命だと考えています。ホームページやご紹介をきっかけにご相談に来られた方の、不動産に関する悩みを少しでも解消することが、私たちのやりがいです。</p>
            <p>これからも不動産の調査・鑑定の精度を高め、多面的・総合的に「解決する力」を磨き、皆様のご期待に応えてまいります。</p>
          </div>
          <p class="sign7">代表取締役 木村 修</p>
        </div>
        <figure class="reveal" data-delay="1">
          <img src={u('/assets/img/office/office-reception.jpg')} width="1200" height="900" alt="事務所の受付" loading="lazy" decoding="async">
          <figcaption>阿佐ヶ谷の事務所</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="strength" aria-labelledby="strength-title">
    <div class="wrap">
      <div class="reveal sechead">
        <h2 class="h2" id="strength-title">ひとつの事務所で、価格から建物まで</h2>
        <p class="note">不動産鑑定業者・一級建築士事務所・宅地建物取引業者・東京都木造住宅耐震診断事務所として登録しています。</p>
      </div>
      <ul class="cols3 reveal">
        <li><h3>不動産鑑定 × 建築</h3><p>一級建築士による建物の精緻な調査と、不動産鑑定士による分析を組み合わせ、建物の状態まで踏まえて不動産を評価します。</p></li>
        <li><h3>評価から売買・改修まで</h3><p>不動産鑑定から、売却・購入の仲介、インスペクション、耐震診断・改修まで、ひとつの窓口でご相談いただけます。</p></li>
        <li><h3>専門家との連携</h3><p>事案に応じて、弁護士・税理士・司法書士などの専門家と連携して対応します。</p></li>
      </ul>
    </div>
  </section>

  <section class="sec" id="overview" aria-labelledby="overview-title">
    <div class="wrap split">
      <div class="split__head reveal"><h2 class="h2" id="overview-title">会社概要</h2></div>
      <table class="ovw reveal" data-delay="1" role="table">
        <tbody role="rowgroup">
          <tr role="row"><th scope="row" role="rowheader">商号</th><td role="cell">{site.name}<br><span class="ovw__sub">{site.nameEn}</span></td></tr>
          <tr role="row"><th scope="row" role="rowheader">設立</th><td role="cell">{company.foundedLabel}</td></tr>
          <tr role="row"><th scope="row" role="rowheader">代表者</th><td role="cell"><a href={u('/profile/')}>{company.representative}</a></td></tr>
          <tr role="row"><th scope="row" role="rowheader">所在地</th><td role="cell">〒{contact.postalCode}<br>{contact.address}</td></tr>
          <tr role="row"><th scope="row" role="rowheader">電話・FAX</th><td role="cell"><span class="nw2">TEL <a href={contact.telHref}>{contact.tel}</a></span>／<span class="nw2">FAX {contact.fax}</span></td></tr>
          <tr role="row"><th scope="row" role="rowheader">メール</th><td role="cell"><a href={`mailto:${contact.email}`}>{contact.email}</a></td></tr>
          <tr role="row"><th scope="row" role="rowheader">営業時間</th><td role="cell">{contact.hours}</td></tr>
          <tr role="row"><th scope="row" role="rowheader">業務内容</th><td role="cell"><ul class="dots">{company.business.map((b) => <li>{b}</li>)}</ul></td></tr>
          <tr role="row"><th scope="row" role="rowheader">登録・許認可</th><td role="cell"><ul class="dots">{company.licenses.map((l) => <li>{l}</li>)}</ul></td></tr>
          <tr role="row"><th scope="row" role="rowheader">所属団体</th><td role="cell"><ul class="dots">{company.memberships.map((m) => <li>{m}</li>)}</ul></td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="sec sec--paper" id="access" aria-labelledby="access-title">
    <div class="wrap">
      <div class="reveal sechead"><h2 class="h2" id="access-title">アクセス</h2></div>
      <div class="access reveal">
        <figure><img src={u('/assets/img/office/office-meeting.jpg')} width="1200" height="900" alt="事務所内の相談スペース" loading="lazy" decoding="async"></figure>
        <div>
          <p class="access__a">{contact.access}<small>{contact.accessSub}</small></p>
          <address>〒{contact.postalCode}<br>{contact.address}</address>
          <p class="access__hint">ご来社の際は、事前にお電話またはメールでご予約ください。</p>
          <a class="btn btn--line" href={contact.mapUrl} target="_blank" rel="noopener">地図を開く（Google マップ）<i aria-hidden="true">→</i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--tight" aria-label="代表プロフィール">
    <div class="wrap">
      <ExpertBox label="代表" text="不動産鑑定士・一級建築士・技術士補（建設部門）。地価公示などの公的評価や、東京地方裁判所（借地非訟事件）の鑑定専門委員などを務めてきました。" />
    </div>
  </section>

  <CtaD7 />
</SiteLayout>
