---
// 【提案用サンプル】SEO・AI検索向けコラム（ビジュアル版・再デザイン）。
// - 方針：カードや囲み枠を減らし、番号付きの見出しと余白で区切る。図解で伝わる説明は本文で繰り返さない。
// - 図の重要な情報は HTML のテキストにも残す（SVG は補助）。細かい比較表・目次は折りたたみ表示。
// - 正式公開時は src/content/column/ へ移す。公開日・更新日・執筆者（木村修本人の確認が取れた場合のみ 'kimura'）を設定する。
// - コラム一覧・トップ・関連欄には出さない（既存ページに影響させない）。
// - 公開日はまだないため表示せず、構造化データにも datePublished / dateModified を入れない。
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import FaqList from '../../components/FaqList.astro';
import CaseCard from '../../components/CaseCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import SampleNotice from '../../samples/SampleNotice.astro';
import MangaIntro from '../../samples/MangaIntro.astro';
import MethodDiagram from '../../samples/MethodDiagram.astro';
import Icon from '../../samples/Icon.astro';
import '../../samples/visual.css';
import { getEntry } from 'astro:content';
import { getService } from '../../data/services';
import { getFaqs, type Faq } from '../../data/faq';
import { profile } from '../../data/profile';
import { article, faqPage } from '../../lib/schema';
import { u } from '../../lib/url';

const path = '/samples/column-inheritance-fair-division/';
const title = '相続した実家を兄弟で公平に分けるには？ 不動産鑑定士が解説する評価の考え方';
const description = '相続した実家を兄弟姉妹で公平に分けるには、「どう分けるか」と「いくらと考えるか」の整理が欠かせません。遺産分割の4つの方法、路線価・固定資産税評価額・査定・鑑定評価の違い、不動産鑑定が役立つ場面を、図解と公的な情報をもとに解説します。';
const checkedOn = '2026年10月10日';

const toc = [
  { id: 'why', text: '話し合いがこじれる3つの理由' },
  { id: 'methods', text: '実家の分け方は4つ' },
  { id: 'prices', text: '「価格」の物差しは1つではない' },
  { id: 'value', text: '路線価と「実際の価値」の違い' },
  { id: 'kantei', text: '不動産鑑定評価が役立つ場面' },
  { id: 'steps', text: '話し合いの進め方と3つの期限' },
  { id: 'policy', text: '当社の考え方' },
];

const methods = [
  { type: 'genbutsu', name: '現物分割', alt: '実家は兄へ、預貯金は妹へ、それぞれそのまま分ける図', what: '実家は兄、預貯金は妹のように、そのままの形で分ける。', caution: '財産の価値に差があると、不公平感が生まれやすい。' },
  { type: 'daisho', name: '代償分割', alt: '実家を兄が引き継ぎ、兄から妹へ代償金を支払う図', what: '実家を引き継ぐ人が、ほかの相続人にお金（代償金）を支払う。', caution: '代償金の額を決めるために実家の評価額が必要。支払う側に資金が必要。' },
  { type: 'kanka', name: '換価分割', alt: '実家を売却し、売却代金を兄と妹で分ける図', what: '実家を売却し、売却代金を分ける。', caution: '実家を手放すことになる。売却の時期や価格の合意が必要。' },
  { type: 'kyoyu', name: '共有分割', alt: '実家を兄と妹の共有にし、それぞれが持ち分を持つ図', what: '実家を兄弟の共有名義にする。', caution: '売却や建替えのたびに共有者の合意が必要になるなど、問題を先送りすることがある。' },
] as const;

// 公的な評価（制度上の目途つき）
const publicPrices = [
  { name: '公示価格（地価公示）', level: 100, value: '100', who: '国土交通省の土地鑑定委員会', why: '土地取引の指標など', when: '毎年1月1日時点', point: '標準地の「正常な価格」。2人以上の不動産鑑定士の鑑定評価をもとに判定' },
  { name: '路線価（相続税路線価）', level: 80, value: '80程度', who: '国税庁', why: '相続税・贈与税の計算', when: '毎年1月1日時点', point: '地価公示価格などをもとにした価格の80％程度を目途に設定' },
  { name: '固定資産税評価額', level: 70, value: '70（宅地）', who: '市町村（東京23区は東京都）', why: '固定資産税などの課税', when: '原則3年ごとに評価替え', point: '宅地は地価公示価格などの7割を目途に評価' },
];
// 比較表（折りたたみ内）用の全項目
const prices = [
  ...publicPrices.map(({ name, who, why, when, point }) => ({ name, who, why, when, point })),
  { name: '査定価格', who: '不動産会社', why: '売却の依頼を受けるときなど', when: '依頼のつど', point: '売れると見込まれる価格についての意見。根拠を明らかにする必要があるが、会社によって差が出ることがある' },
  { name: '鑑定評価額', who: '不動産鑑定士', why: '価格の根拠を第三者に示したいときなど', when: '依頼のつど（価格時点を定めて評価）', point: '国の不動産鑑定評価基準に則り、個々の不動産の事情を調べて経済価値を判定する。根拠を書面で示す' },
];

const scenes = [
  { icon: 'yen', text: '代償金の根拠となる評価額を決めたい' },
  { icon: 'scale', text: '相続人の間で、評価が食い違っている' },
  { icon: 'court', text: '調停・裁判や、遺留分が争点になっている' },
  { icon: 'handshake', text: '相続人の一人が、持ち分を買い取る' },
  { icon: 'key', text: '借地権・底地・共有など、権利関係が複雑' },
  { icon: 'building', text: '古い建物や空き家で、価値がわかりにくい' },
];

// この記事のためのよくある質問（構造化データ FAQPage はこの4問だけに付ける）
const articleFaqs: Faq[] = [
  {
    id: 'a-need-kantei', category: 'theme',
    q: '実家を相続するとき、不動産鑑定は必ず必要ですか？',
    a: [
      'いいえ、必ず必要というわけではありません。相続人全員が、固定資産税評価額や路線価、不動産会社の査定額などを参考にした評価で納得していれば、それをもとに分けることもできます。',
      '評価が食い違うとき、代償金の根拠を示したいとき、調停・裁判になったときなどに、不動産鑑定評価が判断の材料として役立ちます。',
    ],
  },
  {
    id: 'a-rosenka', category: 'theme',
    q: '遺産分割では、路線価で評価すればよいのですか？',
    a: [
      '路線価は、相続税・贈与税を計算するための評価で、地価公示価格などをもとにした価格の80％程度を目途に定められています。',
      '遺産分割では、相続人全員が合意すれば、路線価などを参考に評価することもできます。ただし、実際に取引される価格（時価）とは差が出ることがあります。どの評価額を使うかは、相続人の間で話し合って決めます。',
    ],
  },
  {
    id: 'a-live', category: 'theme',
    q: '兄弟の一人が実家に住み続けたい場合、どう分ければよいですか？',
    a: [
      '実家を引き継ぐ人が、ほかの相続人にお金（代償金）を支払う「代償分割」が選択肢の一つです。代償金の額は実家の評価額をもとに決めるため、その評価に相続人の皆さんが納得できることが大切です。',
      '代償金や分割の方法に関わる税金の扱いは、個別の事情によって異なるため、税理士にご確認ください。',
    ],
  },
  {
    id: 'a-deadline', category: 'theme',
    q: '遺産分割の話し合いに期限はありますか？',
    a: [
      '遺産分割そのものに、いつまでに終えなければならないという期限は定められていません。ただし、相続開始から10年を経過すると、原則として特別受益や寄与分を考慮した分割を主張できなくなります。',
      'また、相続登記の申請義務（取得を知った日から3年以内）や、相続税の申告期限（亡くなったことを知った日の翌日から10か月以内）があります。いずれも例外や経過措置があるため、具体的な期限は専門家にご確認ください。',
    ],
  },
];
// 既存のよくある質問（/faq/ と同じ文面）
const sharedFaqs = getFaqs(['satei-vs-kantei', 'fee', 'consult-only']);

const sources = [
  { title: '民法（第906条・第904条の3）', publisher: 'e-Gov法令検索（デジタル庁）', url: 'https://laws.e-gov.go.jp/law/129AC0000000089' },
  { title: '遺産分割調停', publisher: '裁判所', url: 'https://www.courts.go.jp/saiban/syurui/syurui_kazi/kazi_07_12/index.html' },
  { title: '遺産分割調停について（説明）', publisher: '福岡家庭裁判所', url: 'https://www.courts.go.jp/fukuoka/vc-files/fukuoka/2022/R0407_FC_kaji/R0407_FC_kaji_tyoutei/48_54/R0407_fc_48-4setsumei_isanbunkatsu.pdf' },
  { title: '令和8年分の路線価等について', publisher: '国税庁（札幌国税局）', url: 'https://www.nta.go.jp/about/organization/sapporo/release/r08/rosenka/index.htm' },
  { title: '固定資産税の概要', publisher: '総務省', url: 'https://www.soumu.go.jp/main_sosiki/jichi_zeisei/czaisei/czaisei_seido/149767_08.html' },
  { title: '地価公示制度の概要', publisher: '国土交通省', url: 'https://www.mlit.go.jp/totikensangyo/totikensangyo_fr4_000132.html' },
  { title: '不動産鑑定評価基準', publisher: '国土交通省', url: 'https://www.mlit.go.jp/common/001204083.pdf' },
  { title: '不動産の鑑定評価に関する法律', publisher: 'e-Gov法令検索（デジタル庁）', url: 'https://laws.e-gov.go.jp/law/338AC0000000152' },
  { title: '宅地建物取引業法（第34条の2）', publisher: 'e-Gov法令検索（デジタル庁）', url: 'https://laws.e-gov.go.jp/law/327AC1000000176' },
  { title: '不動産登記法（第76条の2）', publisher: 'e-Gov法令検索（デジタル庁）', url: 'https://laws.e-gov.go.jp/law/416AC0000000123' },
  { title: 'No.4205 相続税の申告と納税', publisher: '国税庁', url: 'https://www.nta.go.jp/taxes/shiraberu/taxanswer/sozoku/4205.htm' },
  { title: 'No.4604 路線価方式による宅地の評価', publisher: '国税庁', url: 'https://www.nta.go.jp/taxes/shiraberu/taxanswer/hyoka/4604.htm' },
];

const inheritance = getService('inheritance');
const svcs = ['inheritance', 'appraisal', 'family-transaction'].map((s) => getService(s));
const caseEntry = await getEntry('cases', 'suginami-rental');
if (!caseEntry) throw new Error('suginami-rental が見つかりません');
---
<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  breadcrumbs={[{ name: 'コラム', path: '/column/' }, { name: title, path }]}
  jsonLd={[
    {
      ...article({ headline: title, description, path, author: 'organization', citations: sources }),
      about: ['遺産分割', '相続した不動産の評価', '路線価', '不動産鑑定評価'],
    },
    faqPage(articleFaqs, path),
  ]}
>
  <SampleNotice />

  <article class="article">
    <header class="page-header page-header--article">
      <div class="container container--narrow">
        <p class="page-header__eyebrow">相続・遺産分割</p>
        <h1 class="page-header__title">{title}</h1>
        <p class="article__meta">
          <span>制度・法令の確認日 {checkedOn}</span>
          <span>株式会社木村不動産鑑定</span>
        </p>
      </div>
    </header>

    <div class="container container--narrow article__body c-body">
      <p class="c-lead">親が遺した実家を、兄弟姉妹でどう分けるか。話し合いを前に進めるための「評価の考え方」を、図で整理しました。</p>

      <div class="c-manga"><MangaIntro /></div>

      <div class="c-points">
        <p class="c-points__title">この記事でわかること</p>
        <ul>
          <li><Icon name="check" size={20} /><span>実家の分け方は4つ。選び方によって「評価」の重みが変わる</span></li>
          <li><Icon name="check" size={20} /><span>不動産の「価格」には複数の物差しがあり、目的が違う</span></li>
          <li><Icon name="check" size={20} /><span>どの評価額を使うかは相続人の間で決める。食い違うときは、不動産鑑定士の評価が判断材料になる</span></li>
        </ul>
      </div>

      <details class="c-toc">
        <summary>目次<span>（{toc.length + 1}項目）</span></summary>
        <ol>
          {toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
          <li><a href="#faq-title">よくあるご質問</a></li>
        </ol>
      </details>

      <!-- 01 -->
      <section class="c-sec" aria-labelledby="why">
        <p class="c-eyebrow">01</p>
        <h2 id="why">話し合いがこじれる3つの理由</h2>
        <ol class="c-reasons">
          <li><span class="c-icon"><Icon name="split" size={26} /></span><b>現金のように分けられない</b><span>土地や建物は、等分するのが難しい財産です。</span></li>
          <li><span class="c-icon"><Icon name="scale" size={26} /></span><b>「いくらか」の物差しが複数ある</b><span>どの評価額を使うかで、金額が変わります。</span></li>
          <li><span class="c-icon"><Icon name="heart" size={26} /></span><b>思い入れや事情が違う</b><span>住み続けたい人、お金がほしい人がいます。</span></li>
        </ol>
        <p class="c-key">1つ目は<strong>「分け方」</strong>、2つ目は<strong>「評価」</strong>の問題。<br class="u-pc">この2つを分けて考えると、論点が整理しやすくなります。</p>
      </section>

      <!-- 02 -->
      <section class="c-sec" aria-labelledby="methods">
        <p class="c-eyebrow">02</p>
        <h2 id="methods">実家の分け方は4つ</h2>
        <p>遺産の分割は、遺産の種類・性質や各相続人の生活の状況など、一切の事情を考慮して行うと定められています（民法第906条）。</p>
        <div class="c-methods">
          {methods.map((m) => (
            <div class="c-method">
              <h3>{m.name}</h3>
              <MethodDiagram type={m.type} label={m.alt} />
              <p class="c-method__what">{m.what}</p>
              <p class="c-method__caution"><span>注意</span>{m.caution}</p>
            </div>
          ))}
        </div>
        <p class="c-key">「兄が住み続け、妹はお金で受け取りたい」なら<strong>代償分割</strong>。<br class="u-pc">代償金の額は、<strong>実家をいくらと考えるか</strong>で決まります。</p>
      </section>

      <!-- 03 -->
      <section class="c-sec" aria-labelledby="prices">
        <p class="c-eyebrow">03</p>
        <h2 id="prices">「価格」の物差しは1つではない</h2>
        <p>兄弟が調べた「実家の価格」が違うのは、物差しの違いによることが少なくありません。</p>

        <h3 class="c-h3">国や自治体が、決まったルールで評価する価格</h3>
        <p class="c-sub">地価公示価格など＝100としたときの、制度上の水準の目途</p>
        <div class="c-bars">
          {publicPrices.map((p) => (
            <div class="c-bar">
              <div class="c-bar__head"><b>{p.name}</b><span>{p.value}</span></div>
              <div class="c-bar__track"><div class="c-bar__fill" style={`width:${p.level}%`} title={`${p.name}：${p.value}`}></div></div>
              <p class="c-bar__meta">{p.who}｜{p.why}｜{p.when}</p>
              <p class="c-bar__note">{p.point}</p>
            </div>
          ))}
        </div>
        <p class="c-small">「80％程度」「7割」は国税庁・総務省が示す制度上の目途で、個々の土地の時価との比率が必ずそうなるわけではありません。</p>

        <h3 class="c-h3">その不動産ごとに評価する価格</h3>
        <div class="c-two">
          <div>
            <p class="c-two__name">査定価格</p>
            <p class="c-two__meta">不動産会社｜売却の依頼を受けるときなど</p>
            <p>売れると見込まれる価格についての意見。根拠を明らかにする必要がありますが、会社によって差が出ることがあります。</p>
          </div>
          <div>
            <p class="c-two__name">鑑定評価額</p>
            <p class="c-two__meta">不動産鑑定士｜価格の根拠を第三者に示したいときなど</p>
            <p>国の不動産鑑定評価基準に則り、個々の不動産の事情を調べて経済価値を判定します。根拠を書面で示します。</p>
          </div>
        </div>
        <p class="c-small">査定や鑑定評価には、地価公示価格に対する決まった割合はありません。</p>

        <details class="c-more">
          <summary>5つの価格を表で比べる</summary>
          <div class="v-table-wrap">
            <table class="v-table">
              <caption class="u-visually-hidden">不動産の価格の種類と、それぞれの目的・特徴</caption>
              <thead><tr><th scope="col">名称</th><th scope="col">誰が</th><th scope="col">何のために</th><th scope="col">時点・見直し</th><th scope="col">特徴</th></tr></thead>
              <tbody>
                {prices.map((p) => (
                  <tr><th scope="row">{p.name}</th><td data-label="誰が">{p.who}</td><td data-label="何のために">{p.why}</td><td data-label="時点・見直し">{p.when}</td><td data-label="特徴">{p.point}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>

      <!-- 04 -->
      <section class="c-sec" aria-labelledby="value">
        <p class="c-eyebrow">04</p>
        <h2 id="value">路線価と「実際の価値」の違い</h2>
        <div class="c-contrast">
          <div class="c-contrast__side">
            <p class="c-contrast__label">路線価による評価</p>
            <p class="c-contrast__big">共通のルールで<br>一律に計算</p>
            <p>相続税の申告で使う評価です。路線価が定められていない地域では、固定資産税評価額に一定の倍率を掛ける「倍率方式」で評価します。</p>
          </div>
          <div class="c-contrast__vs" aria-hidden="true">≠</div>
          <div class="c-contrast__side">
            <p class="c-contrast__label">実際に取引される価格（時価）</p>
            <p class="c-contrast__big">個別の事情が<br>反映される</p>
            <ul class="c-factors">
              <li><Icon name="house" size={24} />土地の形・道路</li>
              <li><Icon name="building" size={24} />建物の状態</li>
              <li><Icon name="key" size={24} />権利関係</li>
              <li><Icon name="chart" size={24} />周辺の取引</li>
            </ul>
          </div>
        </div>
        <p class="c-small">建物が古い場合は、評価額と市場での価値が大きく離れることがあります。権利関係には、借地権・底地・共有などがあります。</p>

        <h3 class="c-h3">遺産分割では、どの評価額を使う？</h3>
        <div class="c-split">
          <div><span class="c-icon"><Icon name="handshake" size={26} /></span><p><b>全員が合意すれば</b>固定資産税評価額や路線価などを参考に評価することもできます（家庭裁判所の説明資料）。</p></div>
          <div><span class="c-icon c-icon--sand"><Icon name="court" size={26} /></span><p><b>意見が対立したら</b>遺産分割調停では、遺産について鑑定を行うなどして事情を把握し、話し合いが進められます。鑑定の費用は当事者の負担です。</p></div>
        </div>
      </section>

      <!-- 05 -->
      <section class="c-sec" aria-labelledby="kantei">
        <p class="c-eyebrow">05</p>
        <h2 id="kantei">不動産鑑定評価が役立つ場面</h2>
        <p>不動産鑑定士は、法律（不動産の鑑定評価に関する法律）にもとづく国家資格です。遺産分割では、たとえば次のような場面で判断の材料になります。</p>
        <ul class="c-scenes">
          {scenes.map((s) => <li><span class="c-icon c-icon--solid"><Icon name={s.icon} size={24} /></span><span>{s.text}</span></li>)}
        </ul>

        <h3 class="c-h3">価格を求める3つの手法（不動産鑑定評価基準）</h3>
        <ul class="c-trio">
          <li><span class="c-icon"><Icon name="tools" size={26} /></span><b>原価法</b><span>いま新たに用意する費用（再調達原価）から、古くなった分を差し引く</span></li>
          <li><span class="c-icon"><Icon name="compare" size={26} /></span><b>取引事例比較法</b><span>似た不動産の取引事例と比べる</span></li>
          <li><span class="c-icon"><Icon name="coins" size={26} /></span><b>収益還元法</b><span>将来生み出すと期待される収益から求める</span></li>
        </ul>
        <p class="c-small">不動産の種類や状況に応じて、手法を使い分けます。</p>

        <p>全員が相続税評価額や査定額で納得している場合など、鑑定評価までは必要ないこともあります。正式な「不動産鑑定評価書」と、鑑定評価基準に則らない「意見書・調査報告書」の違いは、<a href={u('/services/appraisal/')}>不動産鑑定・評価のページ</a>でご案内しています。</p>
        <p class="c-caution"><Icon name="alert" size={20} /><span>相続税の申告では、路線価による評価よりも鑑定評価のほうが低くなる場合に、鑑定評価をもとに申告することが検討される場合があります。どの評価を用いるかは税務上の判断を伴うため、税理士にご相談ください。</span></p>
      </section>

      <!-- 06 -->
      <section class="c-sec" aria-labelledby="steps">
        <p class="c-eyebrow">06</p>
        <h2 id="steps">話し合いの進め方と3つの期限</h2>
        <ol class="c-flow">
          <li><span class="c-flow__num">1</span><div><b>財産と相続人を確認する</b><p>登記事項証明書や固定資産税の課税明細書などで、土地・建物を確かめる。</p></div></li>
          <li><span class="c-flow__num">2</span><div><b>それぞれの希望を出し合う</b><p>住み続けたい、お金で受け取りたい、売ってもよい、など。</p></div></li>
          <li><span class="c-flow__num">3</span><div><b>評価の物差しを決める</b><p>路線価、査定、鑑定評価など、どの評価額を使うか。</p></div></li>
          <li class="c-flow__q"><span class="c-flow__num">4</span><div><b>評価と分け方に、全員が納得できる？</b>
            <dl class="c-branch">
              <div><dt>はい</dt><dd>次のステップへ。</dd></div>
              <div><dt>いいえ</dt><dd>利害関係のない専門家（不動産鑑定士など）の評価を参考に、改めて話し合う。まとまらない場合は家庭裁判所の遺産分割調停を利用できる（不成立の場合は審判へ移る）。</dd></div>
            </dl></div></li>
          <li><span class="c-flow__num">5</span><div><b>合意内容を書面にし、手続きを進める</b><p>遺産分割協議書を作成し、相続登記などを進める。</p></div></li>
        </ol>

        <h3 class="c-h3">知っておきたい3つの期限</h3>
        <ol class="c-deadlines">
          <li><span class="c-deadlines__when">10か月以内</span><b>相続税の申告（必要な場合）</b><span>亡くなったことを知った日の翌日から</span></li>
          <li><span class="c-deadlines__when">3年以内</span><b>相続登記の申請（2024年4月1日から義務化）</b><span>相続の開始と、不動産の取得を知った日から</span></li>
          <li><span class="c-deadlines__when">10年経過後</span><b>原則として、特別受益（生前贈与など）や寄与分（介護などの貢献）を考慮した分割を主張できなくなる（2023年4月1日施行の民法改正）</b><span>相続開始から</span></li>
        </ol>
        <p class="c-small">起算点はそれぞれ異なり、例外や経過措置もあります。遺産分割そのものには、いつまでに終えなければならないという期限は定められていません。具体的な期限は専門家にご確認ください。</p>
      </section>

      <!-- 07 -->
      <section class="c-sec" aria-labelledby="policy">
        <p class="c-eyebrow">07</p>
        <h2 id="policy">当社の考え方</h2>
        <div class="c-policy">
