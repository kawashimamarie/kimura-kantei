  .deadline__when { font-size: 1.375rem; font-weight: 700; color: var(--c-primary); line-height: 1.3; }
  .deadline__what { font-weight: 700; line-height: 1.6; font-size: .9375rem; }
  .deadline__from { font-size: .8125rem; color: var(--c-muted); line-height: 1.6; }

  .policy { display: grid; gap: 1.25rem; padding: clamp(1.25rem, 1rem + 1.5vw, 2rem); border-radius: 16px; background: var(--c-sand-50); border: 1px solid var(--c-sand-100); }
  @media (min-width: 640px) { .policy { grid-template-columns: 140px 1fr; align-items: start; } }
  .policy__photo { width: 120px; height: auto; border-radius: 8px; }
