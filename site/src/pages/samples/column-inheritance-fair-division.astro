  @media (min-width: 640px) { .scene-grid { grid-template-columns: 1fr 1fr; } }
  .scene-grid li { display: grid; grid-template-columns: auto 1fr; gap: .875rem; align-items: center; padding: .875rem 1rem; border-radius: var(--radius); background: var(--c-surface); border: 1px solid var(--c-line); font-size: .9375rem; line-height: 1.7; }
  .scene-grid__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--c-primary); color: #fff; }

