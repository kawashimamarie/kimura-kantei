---
// 【提案用サンプル】既存事例（/cases/suginami-rental/）を補足する「専門家の考え方」ページ（ビジュアル版）。
// - 事例の事実・写真・数値は、現行公式サイト（https://www.kimurakantei.jp/業務内容/）の掲載内容だけを使う。
//   写真は同ページの本事例（杉並区 築48年戸建「空家から貸家に」）の「リフォーム前／後」に掲載されているもの。
// - それ以外は「一般的な解説」として区別し、この事例で実際に行った検討・結果としては書かない。
// - 間取り・構造の図面は実物がないため作らない。独自の投資回収年数の計算もしない。
// - 既存ページからはリンクしない（一覧・関連欄にも出さない）。
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileBox from '../../components/ProfileBox.astro';
import ContactCta from '../../components/ContactCta.astro';
import SampleNotice from '../../samples/SampleNotice.astro';
import Icon from '../../samples/Icon.astro';
import '../../samples/visual.css';
import { getEntry } from 'astro:content';
import { getService } from '../../data/services';
import { article } from '../../lib/schema';
import { u, abs } from '../../lib/url';

const caseEntry = await getEntry('cases', 'suginami-rental');
if (!caseEntry) throw new Error('suginami-rental が見つかりません');
const c = caseEntry.data;
const casePath = '/cases/suginami-rental/';
const path = '/samples/case-suginami-rental-insight/';
const title = '杉並区の空き家を賃貸住宅として再生した事例　専門家はどこを見て「貸す」を提案したのか';
const description = '相続で空き家になった杉並区の借地上の戸建てを、地主様へ返す前にリフォームして賃貸する計画をご提案した事例を、ビフォー・アフターの写真と図解で紹介します。借地権の価値、建物の状態、収支の見方を、事実と一般的な解説に分けて説明します。';
const svcs = c.services.map((s) => getService(s));

const img = (name: string, sizes: number[] = [480, 800]) => ({
  src: u(`/assets/img/samples/${name}-${sizes[sizes.length - 1]}.webp`),
  srcset: sizes.map((w) => `${u(`/assets/img/samples/${name}-${w}.webp`)} ${w}w`).join(', '),
});
const pairs = [
  { title: '外観', before: { ...img('suginami48-exterior-before'), alt: 'リフォーム前の住宅の外観。ブロック塀の向こうに建物が見える' }, after: { ...img('suginami48-exterior-after'), alt: 'リフォーム後の住宅の外観。外壁を塗り替え、バルコニーが新しくなっている' } },
  { title: '玄関まわり', before: { ...img('suginami48-entrance-before'), alt: 'リフォーム前の玄関まわりと庭。草木が伸びている' }, after: { ...img('suginami48-entrance-after'), alt: 'リフォーム後の玄関まわり。新しい玄関ドアとアプローチ、植栽' } },
  { title: '室内（キッチン）', before: { ...img('suginami48-kitchen-before'), alt: 'リフォーム前のダイニングキッチン' }, after: { ...img('suginami48-kitchen-after', [480, 640]), alt: 'リフォーム後のキッチンと室内' } },
];
const eaves = { ...img('suginami48-eaves-before'), alt: 'リフォーム前の外まわりの木部' };

const works = ['耐震', '断熱', '玄関ドア交換', '窓交換', 'バルコニー交換', '間取り変更', '外壁・屋根塗装', '設備更新', '玄関アプローチ・駐車場整備', '庭木剪定'];

// 公開値（現行公式サイトに掲載の計画値）
const COST = 1100; // 万円（約）
const RENT_M = 18; // 万円/月（約）
const RENT_Y = RENT_M * 12; // 216万円
const ratio = ((RENT_Y / COST) * 100).toFixed(1); // 19.6

const sources = [
  { title: '耐震リフォーム事例（杉並区 築48年戸建「空家から貸家に」）', publisher: '株式会社木村不動産鑑定（現行公式サイト）', url: 'https://www.kimurakantei.jp/業務内容/' },
  { title: 'No.4611 借地権の評価', publisher: '国税庁', url: 'https://www.nta.go.jp/taxes/shiraberu/taxanswer/hyoka/4611.htm' },
  { title: '借地借家法（第17条・第19条、附則第6条）', publisher: 'e-Gov法令検索（デジタル庁）', url: 'https://laws.e-gov.go.jp/law/403AC0000000090' },
  { title: '不動産鑑定評価基準', publisher: '国土交通省', url: 'https://www.mlit.go.jp/common/001204083.pdf' },
];
---
<BaseLayout
  title="杉並区の空き家を賃貸住宅として再生した事例の解説"
  description={description}
  path={path}
  ogType="article"
  ogImage={c.cover.src}
  breadcrumbs={[{ name: '事例', path: '/cases/' }, { name: c.title, path: casePath }, { name: '専門家の考え方', path }]}
  jsonLd={[{
    ...article({ headline: title, description, path, image: c.cover.src, author: 'organization', citations: sources }),
    isBasedOn: abs(casePath),
    about: ['借地権', '空き家の活用', '相続した不動産', '賃貸住宅へのリフォーム'],
  }]}
>
  <SampleNotice />

  <article class="article">
    <header class="page-header page-header--article">
      <div class="container container--narrow">
        <p class="page-header__eyebrow">事例解説</p>
        <h1 class="page-header__title">杉並区の空き家を賃貸住宅として再生した事例<span class="sub">専門家はどこを見て「貸す」を提案したのか</span></h1>
        <p class="article__meta">{c.meta}</p>
        <ul class="case-card__tags">{c.tags.map((t) => <li>{t}</li>)}</ul>
      </div>
    </header>

    <div class="container container--narrow article__body">
      <p class="v-lead">相続で空き家になった借地上の戸建てを、地主様へ返す前に、リフォームして賃貸する計画をご提案した事例です。写真と図で、不動産鑑定士・一級建築士がどこを確かめながら選択肢を考えるのかをご紹介します。</p>

      <div class="legend" role="note">
        <p class="legend__title">このページの読み方</p>
        <ul>
          <li><span class="v-tag v-tag--fact">事例の事実</span>当社が現行の公式サイトで公開している、この事例の内容・写真・数値です。</li>
          <li><span class="v-tag v-tag--general">一般的な解説</span>同じような状況で一般に確かめることが多い点です。この事例で実際に行った検討の内容や結果を示すものではありません。</li>
        </ul>
      </div>

      <nav class="toc toc--article" aria-label="目次">
        <p class="toc__title">目次</p>
        <ol class="toc__list toc__list--ol">
          <li><a href="#beforeafter">ビフォー・アフター</a></li>
          <li><a href="#facts">この事例のあらまし</a></li>
          <li><a href="#options">空き家の選択肢を比べる</a></li>
          <li><a href="#flow">改修から収益化までの流れ</a></li>
          <li><a href="#numbers">収支のイメージ</a></li>
          <li><a href="#relation">建物・収益・価値の関係</a></li>
        </ol>
      </nav>

      <!-- 1. ビフォー・アフター -->
      <section class="v-sec" aria-labelledby="beforeafter">
        <h2 id="beforeafter">ビフォー・アフター <span class="v-tag v-tag--fact">事例の事実</span></h2>
        <div class="ba-list">
          {pairs.map((p) => (
            <figure class="ba">
              <figcaption class="ba__title">{p.title}</figcaption>
              <div class="ba__pair">
                <div class="ba__item">
                  <span class="ba__badge">リフォーム前</span>
                  <img src={p.before.src} srcset={p.before.srcset} sizes="(min-width: 900px) 420px, 50vw" width="800" height="600" alt={p.before.alt} loading="lazy" decoding="async">
                </div>
                <div class="ba__arrow" aria-hidden="true">→</div>
                <div class="ba__item">
                  <span class="ba__badge ba__badge--after">リフォーム後</span>
                  <img src={p.after.src} srcset={p.after.srcset} sizes="(min-width: 900px) 420px, 50vw" width="800" height="600" alt={p.after.alt} loading="lazy" decoding="async">
                </div>
              </div>
            </figure>
          ))}
        </div>
        <p class="v-note">写真は、現行の公式サイトでこの事例の「リフォーム前」「リフォーム後」として掲載しているものです。撮影の位置・角度は前後で異なります。工事の一覧と、そのほかの写真は<a href={u(casePath)}>事例ページ</a>でご覧いただけます。</p>
      </section>

      <!-- 2. あらまし -->
      <section class="v-sec" aria-labelledby="facts">
        <h2 id="facts">この事例のあらまし <span class="v-tag v-tag--fact">事例の事実</span></h2>
        <ol class="story">
          <li><span class="story__icon"><Icon name="people" size={24} /></span><div><b>相続で空き家に</b>ご両親が亡くなり、相続人であるご相談者様が引き継いだ戸建て（杉並区・築48年）が空き家になりました。</div></li>
          <li><span class="story__icon"><Icon name="key" size={24} /></span><div><b>土地は借地</b>借地権（旧借地法）。ご相談者様は当初、地主様へ土地を<strong>無償で返還する</strong>お気持ちでした。</div></li>
          <li><span class="story__icon"><Icon name="rent" size={24} /></span><div><b>「貸す」をご提案</b>返還する前に、リフォームして賃貸する選択肢をご提案。フルリノベーションで建物の耐用年数を延ばす計画です。</div></li>
          <li><span class="story__icon"><Icon name="sell" size={24} /></span><div><b>将来の選択肢も</b>借地権付建物として売却する道も残っています。</div></li>
        </ol>
      </section>

      <!-- 3. 選択肢の比較 -->
      <section class="v-sec" aria-labelledby="options">
        <h2 id="options">空き家の選択肢を比べる <span class="v-tag v-tag--general">一般的な解説</span></h2>
        <p>相続した借地上の建物が空き家になったとき、考えられる道は大きく分けて次の3つです。</p>
        <div class="opt-grid">
          <div class="opt">
            <p class="opt__head"><span class="opt__icon"><Icon name="sell" size={30} /></span>売却する</p>
            <dl>
              <div><dt>得られるもの</dt><dd>まとまった資金に換えられます。</dd></div>
              <div><dt>主な負担・注意点</dt><dd>土地の賃借権を譲渡するには、原則として地主様の承諾が必要です（承諾に代わる裁判所の許可の制度もあります。借地借家法第19条）。</dd></div>
              <div><dt>確かめたいこと</dt><dd>借地契約の内容、地主様のご意向、借地権付建物としての価値。</dd></div>
            </dl>
          </div>
          <div class="opt opt--pick">
            <p class="opt__flag"><span class="v-tag v-tag--fact">事例の事実</span>この事例でご提案</p>
            <p class="opt__head"><span class="opt__icon"><Icon name="rent" size={30} /></span>直して貸す</p>
            <dl>
              <div><dt>得られるもの</dt><dd>借地権を持ち続けながら、賃料収入を得られます。</dd></div>
              <div><dt>主な負担・注意点</dt><dd>改修費のほか、空室・修繕・地代・税金などの負担があります。</dd></div>
              <div><dt>確かめたいこと</dt><dd>建物を直して使えるか、賃貸の需要、増改築を制限する取り決めの有無。</dd></div>
            </dl>
          </div>
          <div class="opt">
            <p class="opt__head"><span class="opt__icon"><Icon name="return" size={30} /></span>その他の活用</p>
            <dl>
              <div><dt>例</dt><dd>土地の返還、ご自身やご家族の住まいとしての利用など。</dd></div>
              <div><dt>主な負担・注意点</dt><dd>返還すると、建物の管理や地代の負担から離れられる一方、借地権の価値を手放すことになりえます。返還の条件は契約や話し合いで決まります。</dd></div>
              <div><dt>この事例では</dt><dd><span class="v-tag v-tag--fact">事例の事実</span> 当初は、土地の無償返還をお考えでした。</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <!-- 4. 流れ -->
      <section class="v-sec" aria-labelledby="flow">
        <h2 id="flow">改修から収益化までの流れ</h2>
        <figure class="v-figure">
          <p class="v-figure__title">借地上の空き家を直して貸すまで<span class="v-tag v-tag--general">一般的な流れ</span><span class="v-tag v-tag--fact">事例の事実</span>は本事例で公開している内容</p>
          <ol class="v-flow">
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="doc" size={22} />権利と契約を確かめる</p><p>借地契約の期間・地代・増改築の取り決めなどを確認します。1992年8月1日の借地借家法施行より前に設定された借地権では、契約の更新などに旧借地法の規定が引き続き適用されます（同法附則第6条など）。</p></div></li>
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="search" size={22} />建物の状態を確かめる</p><p>構造や劣化の状態、耐震性を確かめ、直して使い続けられるかを見極めます。</p>
              <figure class="flow-photo">
                <img src={eaves.src} srcset={eaves.srcset} sizes="(min-width: 768px) 360px, 80vw" width="800" height="600" alt={eaves.alt} loading="lazy" decoding="async">
                <figcaption><span class="v-tag v-tag--fact">事例の事実</span> リフォーム前の外まわり（本事例）</figcaption>
              </figure></div></li>
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="chart" size={22} />改修計画と収支を考える</p><p>どこまで手を入れるか、費用と賃料の見通しを検討します。</p><p class="fact-line"><span class="v-tag v-tag--fact">事例の事実</span> フルリノベーションで耐用年数を延ばす計画に。</p></div></li>
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="handshake" size={22} />必要な承諾・手続き</p><p>増改築を制限する取り決めがある場合は、地主様の承諾が必要になることがあります。協議が調わないときに、裁判所が承諾に代わる許可を与える制度もあります（借地借家法第17条第2項）。</p></div></li>
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="tools" size={22} />改修工事</p><p class="fact-line"><span class="v-tag v-tag--fact">事例の事実</span> 本事例の工事内容</p><ul class="chips">{works.map((w) => <li>{w}</li>)}</ul></div></li>
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="rent" size={22} />賃貸する</p><p class="fact-line"><span class="v-tag v-tag--fact">事例の事実</span> 家賃は約18万円の計画です。</p></div></li>
            <li class="v-flow__step"><div class="v-flow__body"><p class="v-flow__title"><Icon name="coins" size={22} />収益と将来の選択肢</p><p class="fact-line"><span class="v-tag v-tag--fact">事例の事実</span> 約7年で投資を回収し、その後は純収益が得られる計画。将来は借地権付建物として売却する道も残っています。</p></div></li>
          </ol>
        </figure>
      </section>

      <!-- 5. 収支イメージ -->
      <section class="v-sec" aria-labelledby="numbers">
        <h2 id="numbers">収支のイメージ</h2>
        <p class="v-figure__title" style="margin-bottom:.75rem"><span class="v-tag v-tag--fact">事例の事実</span>公開している計画の数字</p>
        <div class="v-stats">
          <div class="v-stat"><p class="v-stat__label">リフォーム代金</p><p class="v-stat__num">約1,100<small>万円</small></p></div>
          <div class="v-stat"><p class="v-stat__label">家賃</p><p class="v-stat__num">約18<small>万円/月</small></p></div>
          <div class="v-stat"><p class="v-stat__label">投資回収の見込み（計画）</p><p class="v-stat__num">約7<small>年</small></p><p class="v-stat__sub">その後は純収益が得られる計画</p></div>
          <div class="v-stat v-stat--full"><p class="v-stat__label">現行サイトに記載している利回り</p><p class="v-stat__text">表面利回り約20％（実質約16％）</p><p class="v-stat__sub">計算の基礎となる金額（分母）や経費の内訳は記載していません。</p></div>
        </div>

        <figure class="v-figure">
          <p class="v-figure__title">改修費に対する年間賃料の単純比率<span class="v-tag v-tag--general">公開値からの計算</span></p>
          <div class="v-bars">
            <div class="v-bar"><div class="v-bar__label"><b>リフォーム代金</b><span class="v-bar__value">約{COST.toLocaleString()}万円</span></div><div class="v-bar__track"><div class="v-bar__fill v-bar__fill--sand" style="width:100%" title={`リフォーム代金：約${COST.toLocaleString()}万円`}></div></div></div>
            <div class="v-bar"><div class="v-bar__label"><b>年間の家賃（約18万円×12か月）</b><span class="v-bar__value">約{RENT_Y}万円</span></div><div class="v-bar__track"><div class="v-bar__fill" style={`width:${(RENT_Y / COST) * 100}%`} title={`年間の家賃：約${RENT_Y}万円`}></div></div></div>
          </div>
          <figcaption>年間の家賃（約{RENT_Y}万円）をリフォーム代金（約1,100万円）で割った<strong>単純な比率は約{ratio}％</strong>です。物件の取得費、土地・建物（借地権を含む）の価値、空室、運営経費、税金などを考慮していないため、<strong>不動産投資の利回りではありません</strong>。</figcaption>
        </figure>

        <div class="v-callout">
          <span class="v-callout__icon"><Icon name="doc" size={28} /></span>
          <p>現行サイトの「表面利回り約20％（実質約16％）」は、計画時の数字としてそのまま掲載しているものです。何を分母として計算したかは記載していないため、上の単純比率と同じ計算であるとは限りません。不動産投資でいう利回りは、一般に物件の購入価格などの投資額全体を基礎として計算するもので、改修費だけを基礎にした比率とは意味が異なります。</p>
        </div>

        <div class="v-callout v-callout--sand">
          <span class="v-callout__icon"><Icon name="alert" size={28} /></span>
          <p>「約7年」は、公開している計画上の見込みです。実際の回収期間は、空室の期間・修繕・税金などによって変わります。このページでは、家賃だけでリフォーム代金を割った年数を「回収期間」として示すことはしていません。</p>
        </div>
      </section>

      <!-- 6. 関係図 -->
      <section class="v-sec" aria-labelledby="relation">
        <h2 id="relation">建物・収益・価値の関係 <span class="v-tag v-tag--general">一般的な解説</span></h2>
        <p>不動産鑑定士と一級建築士の視点を重ねると、建物の状態から不動産の価値までが、ひとつながりで見えてきます。</p>
        <ol class="chain">
          <li><span class="chain__icon"><Icon name="search" size={28} /></span><b>建物の状態</b><p>構造・劣化・耐震性によって、必要な改修の内容と費用が変わります。</p></li>
          <li><span class="chain__icon"><Icon name="tools" size={28} /></span><b>改修</b><p>安全性や住み心地を高める改修は、賃料や入居者の決まりやすさに影響しえます。</p></li>
          <li><span class="chain__icon"><Icon name="coins" size={28} /></span><b>収益性</b><p>賃料から経費を差し引いた収益が、利回りや回収の見通しを左右します。</p></li>
          <li><span class="chain__icon"><Icon name="scale" size={28} /></span><b>不動産の価値</b><p>鑑定評価には、将来の収益から価格を求める「収益還元法」があります。借地権付建物の価値は、契約の内容や地主様との関係などにも左右されます。</p></li>
        </ol>
        <div class="v-callout">
          <span class="v-callout__icon"><Icon name="key" size={28} /></span>
          <p>相続税の計算では、借地権も財産として評価の対象になり、一般に「その土地を更地とした場合の価額 × 借地権割合」で評価されます（国税庁）。ただし、市場で取引される価格と一致するとは限りません。「返す」と決める前に、手放そうとしているものの価値を確かめておくことが大切です。</p>
        </div>
        <p style="margin-top:1.25rem">相続人が複数いる場合は、「返す」「貸す」「売る」の選択が遺産分割の話し合いとも関わります。評価の考え方は、コラム「<a href={u('/samples/column-inheritance-fair-division/')}>相続した実家を兄弟で公平に分けるには？</a>」で図解しています。</p>
      </section>

