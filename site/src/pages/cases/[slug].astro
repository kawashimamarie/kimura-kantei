---
import { getCollection, render } from 'astro:content';
import '../../styles/d7/cases.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Crumbs from '../../components/d7/Crumbs.astro';
import CaseTags from '../../components/d7/CaseTags.astro';
import ColumnRows from '../../components/d7/ColumnRows.astro';
import ExpertBox from '../../components/d7/ExpertBox.astro';
import CtaD7 from '../../components/d7/CtaD7.astro';
import { getService } from '../../data/services';
import { article } from '../../lib/schema';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const path = `/cases/${entry.id}/`;
const { Content } = await render(entry);
const svcs = d.services.map((s) => getService(s));
const columns = (await getCollection('column')).filter((c) => d.relatedColumns.includes(c.id));
const others = (await getCollection('cases')).filter((c) => c.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
const crumbs = [{ name: '事例', path: '/cases/' }, { name: d.title, path }];
// 本文は paper。以降は直前と同じ背景にならないよう交互にする
const toneColumns = '';
const toneOthers = columns.length > 0 ? 'sec--paper' : '';
---
<SiteLayout
  title={`${d.title}（事例）`}
  description={d.description}
  path={path}
  ogType="article"
  ogImage={d.cover.src}
  breadcrumbs={crumbs}
  jsonLd={[article({ headline: d.title, description: d.description, path, image: d.cover.src, author: 'organization' })]}
>
  <section class="lhero">
    <div class="wrap">
      <Crumbs items={[{ name: 'トップ', path: '/' }, ...crumbs]} />
      <header class="chero">
        <p class="kicker">事例</p>
        <h1 class="h1">{d.title}</h1>
        <p class="cmeta">{d.meta}</p>
        <CaseTags tags={d.tags} />
      </header>
    </div>
  </section>

  <article class="sec sec--paper" aria-label="事例の内容">
    <div class="wrap cbodywrap">
      <figure class="cfig" style={`aspect-ratio:${d.cover.width}/${d.cover.height}`}>
        <img src={u(d.cover.src)} width={d.cover.width} height={d.cover.height} alt={d.cover.alt}>
      </figure>

      <div class="csum">
        <dl class="cdl">
          <div><dt>ご相談</dt><dd>{d.summary.consult}</dd></div>
          <div><dt>課題</dt><dd>{d.summary.issue}</dd></div>
          <div><dt>専門家の視点</dt><dd>{d.summary.approach}</dd></div>
          <div><dt>結果</dt><dd>{d.summary.result}</dd></div>
        </dl>
      </div>

      <div class="cbody"><Content /></div>

      {d.gallery.length > 0 && (
        <div class="pair">
          {d.gallery.map((g) => (
            <figure style={`--ar:${g.width / g.height};--w:${g.width}`}>
              <img src={u(g.src)} width={g.width} height={g.height} alt={g.alt} loading="lazy" decoding="async">
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      <nav class="others csvc" aria-labelledby="rel-svc">
        <h2 id="rel-svc">この事例に関連するご相談</h2>
        <ul>
          {svcs.map((s) => <li><a href={u(`/services/${s.slug}/`)}>{s.name}</a></li>)}
        </ul>
      </nav>

      <div class="cexp"><ExpertBox /></div>
    </div>
  </article>

  {columns.length > 0 && (
    <section class={`sec ${toneColumns}`} aria-labelledby="col-title">
      <div class="wrap">
        <div class="reveal" style="margin-bottom:36px"><h2 class="h2" id="col-title">関連するコラム</h2></div>
        <ColumnRows items={columns} />
      </div>
    </section>
  )}

  <section class={`sec ${toneOthers}`} aria-labelledby="others-title">
    <div class="wrap">
      <div class="reveal" style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:36px">
        <h2 class="h2" id="others-title">ほかの事例</h2><a class="u-link" href={u('/cases/')}>事例の一覧を見る</a>
      </div>
      <div class="rel">
        {others.map((c, i) => (
          <a class="reveal" data-delay={i % 2 ? '1' : undefined} href={u(`/cases/${c.id}/`)}>
            <figure><img src={u(c.data.cover.src)} width={c.data.cover.width} height={c.data.cover.height} alt={c.data.cover.alt} loading="lazy" decoding="async"></figure>
            <div>
              <p class="rel__m">{c.data.meta}</p>
              <h3>{c.data.title}</h3>
              <p class="t">{c.data.teaser}</p>
              <CaseTags tags={c.data.tags.slice(0, 2)} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaD7 />
</SiteLayout>
