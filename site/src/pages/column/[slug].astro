---
import { getCollection, render } from 'astro:content';
import '../../styles/d7/column.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Crumbs from '../../components/d7/Crumbs.astro';
import PageNav from '../../components/d7/PageNav.astro';
import FaqD7 from '../../components/d7/FaqD7.astro';
import CaseRows from '../../components/d7/CaseRows.astro';
import ColumnRows from '../../components/d7/ColumnRows.astro';
import CtaD7 from '../../components/d7/CtaD7.astro';
import { getService } from '../../data/services';
import { getFaqs } from '../../data/faq';
import { profile } from '../../data/profile';
import { site } from '../../data/site';
import { article } from '../../lib/schema';
import { formatDate, isoDate } from '../../lib/date';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const columns = await getCollection('column');
  return columns.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const path = `/column/${entry.id}/`;
const { headings } = await render(entry);
// 本文のHTMLはそのまま使い、表だけをスクロール用の div で包む（表の構造・文言は変えない）
const html = (entry.rendered?.html ?? '').replace(
  /<table>([\s\S]*?)<\/table>/g,
  '<div class="twrap" role="region" aria-label="表（横にスクロールできます）" tabindex="0"><table>$1</table></div>',
);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
const hasToc = toc.length > 2;
const svcs = d.services.map((s) => getService(s));
const faqs = getFaqs(d.relatedFaq);
const cases = (await getCollection('cases')).filter((c) => d.relatedCases.includes(c.id)).sort((a, b) => a.data.order - b.data.order);
const others = (await getCollection('column')).filter((c) => c.id !== entry.id);
const crumbs = [{ name: 'コラム', path: '/column/' }, { name: d.title, path }];
// 本文は paper。以降は直前と同じ背景にならないよう交互にする
let k = 0;
const tone = () => (k++ % 2 === 0 ? '' : 'sec--paper');
const toneFaq = faqs.length > 0 ? tone() : '';
const toneCases = cases.length > 0 ? tone() : '';
const toneOthers = others.length > 0 ? tone() : '';
const authorText = d.author === 'kimura' ? `${profile.name}（${profile.credentials.slice(0, 2).join('・')}）` : site.name;
---
<SiteLayout
  title={d.title}
  description={d.description}
  path={path}
  ogType="article"
  breadcrumbs={crumbs}
  jsonLd={[article({ headline: d.title, description: d.description, path, datePublished: d.publishedAt, dateModified: d.updatedAt, author: d.author, citations: d.sources })]}
>
  <section class="lhero">
    <div class="wrap">
      <Crumbs items={[{ name: 'トップ', path: '/' }, ...crumbs]} />
      <header class="ahero">
        <p class="kicker">{d.category}</p>
        <h1 class="h1">{d.title}</h1>
        <p class="ameta">
          <span>公開日 <time datetime={isoDate(d.publishedAt)}>{formatDate(d.publishedAt)}</time></span>
          <span>更新日 <time datetime={isoDate(d.updatedAt)}>{formatDate(d.updatedAt)}</time></span>
          <span>執筆：{authorText}</span>
        </p>
      </header>
    </div>
  </section>
  {hasToc && <div class="pnav--sp"><PageNav items={toc} /></div>}

  <section class="sec sec--paper" aria-label="記事本文">
    <div class:list={['wrap', hasToc && 'pgrid']}>
      {hasToc && (
        <nav class="ptoc" aria-label="目次">
          <h2>目次</h2>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
        </nav>
      )}
      <article class="abody">
        <div class="apoints">
          <h2>この記事の要点</h2>
          <ul>{d.points.map((p) => <li>{p}</li>)}</ul>
        </div>

        <div class="atext"><Fragment set:html={html} /></div>

        {d.sources.length > 0 && (
          <section class="asrc" aria-labelledby="src-title">
            <h2 id="src-title">参考資料</h2>
            <ul>
              {d.sources.map((s) => (
                <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.title}</a> : s.title}<span>（{s.publisher}）</span></li>
              ))}
            </ul>
          </section>
        )}

        {svcs.length > 0 && (
          <nav class="others arel" aria-labelledby="rel-svc">
            <h2 id="rel-svc">このテーマのご相談</h2>
            <ul>{svcs.map((s) => <li><a href={u(`/services/${s.slug}/`)}>{s.name}</a></li>)}</ul>
          </nav>
        )}

        <section class="aauthor" aria-labelledby="author-title">
          <h2 id="author-title">この記事について</h2>
          <div class="aauthor__in">
            <img src={u(profile.photo)} width={profile.photoWidth} height={profile.photoHeight} alt={`${profile.name}の写真`} loading="lazy" decoding="async">
            <div>
              <p>{d.author === 'kimura' ? `${profile.name}（${profile.credentials.join('・')}）が執筆しました。` : `${site.name}が執筆しました。`}{d.originalUrl && `${formatDate(d.publishedAt)}に当社ブログで公開した記事を、新しいサイトへの移行にあわせて再構成しています。`}</p>
              <p>ご相談には、代表の{profile.name}（{profile.credentials.slice(0, 2).join('・')}）が対応します。</p>
              <a class="u-link" href={u('/profile/')}>代表のプロフィールを見る</a>
            </div>
          </div>
        </section>
      </article>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class={`sec ${toneFaq}`} aria-labelledby="faq-title">
      <div class="wrap">
        <div class="reveal" style="margin-bottom:36px"><h2 class="h2" id="faq-title">関連するご質問</h2></div>
        <div style="max-width:860px"><FaqD7 items={faqs} /></div>
      </div>
    </section>
  )}

  {cases.length > 0 && (
    <section class={`sec ${toneCases}`} aria-labelledby="cases-title">
      <div class="wrap">
        <div class="reveal secrow"><h2 class="h2" id="cases-title">関連する事例</h2><a class="u-link" href={u('/cases/')}>事例の一覧を見る</a></div>
        <CaseRows items={cases} />
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class={`sec ${toneOthers}`} aria-labelledby="others-title">
      <div class="wrap">
        <div class="reveal secrow"><h2 class="h2" id="others-title">ほかのコラム</h2><a class="u-link" href={u('/column/')}>コラムの一覧を見る</a></div>
        <ColumnRows items={others} />
      </div>
    </section>
  )}

  <CtaD7 />
</SiteLayout>
