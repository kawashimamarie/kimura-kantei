---
import { getCollection } from 'astro:content';
import '../../styles/d7/column.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/d7/PageHero.astro';
import CtaD7 from '../../components/d7/CtaD7.astro';
import { formatDate, isoDate } from '../../lib/date';
import { u } from '../../lib/url';

const columns = (await getCollection('column')).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const crumbs = [{ name: 'コラム', path: '/column/' }];
---
<SiteLayout
  title="コラム"
  description="不動産の売買・相続・建物・耐震などについて、木村不動産鑑定が実務の視点で解説するコラムです。"
  path="/column/"
  breadcrumbs={crumbs}
>
  <PageHero title="コラム" lead="不動産の価格や建物について、ご相談の多いテーマを実務の視点でわかりやすく解説します。" crumbs={crumbs} />

  <section class="sec sec--paper" aria-label="コラムの一覧">
    <div class="wrap">
      <div class="clist">
        {columns.map((c) => (
          <article class="citem reveal">
            <div>
              <p class="citem__m">{c.data.category}</p>
              <p class="citem__d"><time datetime={isoDate(c.data.updatedAt)}>{formatDate(c.data.updatedAt)} 更新</time></p>
            </div>
            <div>
              <h2><a href={u(`/column/${c.id}/`)}>{c.data.title}</a></h2>
              <p class="t">{c.data.description}</p>
              <a class="u-link" href={u(`/column/${c.id}/`)}>コラムを読む</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaD7 />
</SiteLayout>
