---
import SiteLayout from '../layouts/SiteLayout.astro';
import { u } from '../lib/url';
---
<SiteLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" path="/404.html">
  <section class="sec sec--paper" aria-labelledby="nf-title">
    <div class="wrap notfound">
      <h1 class="h1" id="nf-title">ページが見つかりません</h1>
      <p class="notfound__t">お探しのページは、移動または削除された可能性があります。</p>
      <ul class="notfound__links">
        <li><a class="btn" href={u('/')}>トップページ<i aria-hidden="true">→</i></a></li>
        <li><a class="btn btn--line" href={u('/services/')}>ご相談内容<i aria-hidden="true">→</i></a></li>
        <li><a class="btn btn--line" href={u('/contact/')}>お問い合わせ<i aria-hidden="true">→</i></a></li>
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  .notfound { padding-top: 24px; padding-bottom: 24px; max-width: 860px; }
  .notfound__t { margin-top: 20px; font-size: 16px; line-height: 2; color: var(--ink-3); }
  .notfound__links { display: flex; flex-wrap: wrap; gap: 14px 16px; margin-top: 36px; padding-top: 32px; border-top: 1px solid var(--ink); }
  @media (max-width: 767px) { .notfound__links { flex-direction: column; } .notfound__links .btn { width: 100%; } }
</style>
