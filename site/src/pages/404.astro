---
import BaseLayout from '../layouts/BaseLayout.astro';
import { u } from '../lib/url';
---
<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" path="/404.html">
  <section class="section section--white">
    <div class="container container--narrow notfound">
      <h1 class="page-header__title">ページが見つかりません</h1>
      <p>お探しのページは、移動または削除された可能性があります。</p>
      <ul class="notfound__links">
        <li><a href={u('/')}>トップページ</a></li>
        <li><a href={u('/services/')}>ご相談内容</a></li>
        <li><a href={u('/contact/')}>お問い合わせ</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
