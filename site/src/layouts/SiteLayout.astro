---
// D7 共通レイアウト（下層ページ用）。ヘッダー・フッター・SP固定ボタン・スクロール表示のスクリプトをまとめる。
// トップページの TopLayout と同じ部品・同じ値を使うが、ファーストビューや大きな写真は持たない。
import '../styles/d7/vars.css';
import '../styles/d7/base.css';
import '../styles/d7/shell.css';
import '../styles/d7/parts.css';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/d7/SiteHeader.astro';
import SiteFooter from '../components/d7/SiteFooter.astro';
import SpBar from '../components/d7/SpBar.astro';
import ShellScript from '../components/d7/ShellScript.astro';

interface Props {
  title: string;
  fullTitle?: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: { name: string; path: string }[];
  jsonLd?: object[];
}
const { path, ...seo } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <SeoHead path={path} {...seo}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho+B1:wght@600;700;800&display=swap">
    <script is:inline>document.documentElement.classList.add('js');</script>
  </SeoHead>
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <SiteHeader path={path} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
  <SpBar />
  <ShellScript />
</body>
</html>
