---
// 全ページ共通のレイアウト。<head>（title・meta・canonical・OGP・構造化データ）と
// ヘッダー・フッター・パンくず・SP固定ボタンをまとめて出力する。
// ※トップページだけは TopLayout.astro を使う（デザインが異なるため）。
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SeoHead from '../components/SeoHead.astro';
import { u } from '../lib/url';

interface Props {
  title: string; // <title>。「｜株式会社木村不動産鑑定」は自動で付く（トップは fullTitle を使う）
  fullTitle?: string;
  description: string;
  path: string; // 例：'/services/rent/'
  ogType?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: { name: string; path: string }[]; // トップ以外。最後が現在のページ
  jsonLd?: object[];
}

const { path, breadcrumbs = [], ...seo } = Astro.props;
const crumbs = breadcrumbs.length ? [{ name: 'トップ', path: '/' }, ...breadcrumbs] : [];
---
<!doctype html>
<html lang="ja">
<head>
  <SeoHead path={path} breadcrumbs={breadcrumbs} {...seo}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap">
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline src={u('/assets/js/main.js')} defer></script>
  </SeoHead>
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <Header path={path} />
  <main id="main">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <slot />
  </main>
  <Footer />
  <div class="sp-cta" aria-label="お問い合わせ">
    <a class="sp-cta__btn sp-cta__btn--tel" href="tel:0353569158">電話で相談</a>
    <a class="sp-cta__btn sp-cta__btn--main" href={u('/contact/')}>相談を申し込む</a>
  </div>
</body>
</html>
