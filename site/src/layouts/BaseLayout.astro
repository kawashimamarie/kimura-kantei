---
// 全ページ共通のレイアウト。<head>（title・meta・canonical・OGP・構造化データ）と
// ヘッダー・フッター・パンくず・SP固定ボタンをまとめて出力する。
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { u, abs } from '../lib/url';
import { organization, breadcrumbList } from '../lib/schema';

interface Props {
  title: string; // <title>。「｜株式会社木村不動産鑑定」は自動で付く（トップは fullTitle を使う）
  fullTitle?: string;
  description: string;
  path: string; // 例：'/services/rent/'
  ogType?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: { name: string; path: string }[]; // トップ以外。最後が現在のページ
  jsonLd?: object[];
}

const { title, fullTitle, description, path, ogType = 'website', ogImage, breadcrumbs = [], jsonLd = [] } = Astro.props;
const pageTitle = fullTitle ?? `${title}｜${site.name}`;
const canonical = abs(path);
const crumbs = breadcrumbs.length ? [{ name: 'トップ', path: '/' }, ...breadcrumbs] : [];
const graph = [organization(), ...(crumbs.length ? [breadcrumbList(crumbs)] : []), ...jsonLd];
const ldJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  {site.noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="canonical" href={canonical}>

  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {ogImage && <meta property="og:image" content={abs(ogImage)}>}
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>

  <link rel="icon" href={u('/assets/img/logo/favicon.png')} type="image/png">
  <meta name="theme-color" content="#2f5a5e">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap">
  <script is:inline>document.documentElement.classList.add('js');</script>
  <script is:inline src={u('/assets/js/main.js')} defer></script>
  <script is:inline type="application/ld+json" set:html={ldJson}></script>
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <Header path={path} />
  <main id="main">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    <slot />
  </main>
  <Footer />
  <div class="sp-cta" aria-label="お問い合わせ">
    <a class="sp-cta__btn sp-cta__btn--tel" href="tel:0353569158">電話で相談</a>
    <a class="sp-cta__btn sp-cta__btn--main" href={u('/contact/')}>相談を申し込む</a>
  </div>
</body>
</html>
