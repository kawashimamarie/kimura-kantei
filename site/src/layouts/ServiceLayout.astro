---
// サービスページ共通のレイアウト。
// ページ固有の本文は <slot /> に書き、以下はサービスの slug から自動で組み立てる：
//   パンくず・Service 構造化データ・相談者の悩み・ご相談の流れ・関連FAQ・関連事例・関連記事・
//   担当者（プロフィール）・ほかのご相談内容・問い合わせ案内
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import FlowSteps from '../components/FlowSteps.astro';
import FaqList from '../components/FaqList.astro';
import CaseCard from '../components/CaseCard.astro';
import ColumnCard from '../components/ColumnCard.astro';
import ProfileBox from '../components/ProfileBox.astro';
import ContactCta from '../components/ContactCta.astro';
import { getService, services } from '../data/services';
import { getFaqs } from '../data/faq';
import { service as serviceLd } from '../lib/schema';
import { u } from '../lib/url';

interface Props {
  slug: string;
  title: string; // h1
  metaTitle: string; // <title>
  description: string;
  lead: string;
  areaServed?: string;
  profileText?: string;
}
const { slug, title, metaTitle, description, lead, areaServed, profileText } = Astro.props;
const svc = getService(slug);
const path = `/services/${slug}/`;
const faqs = getFaqs(svc.relatedFaq);
const allCases = await getCollection('cases');
const cases = allCases.filter((c) => c.data.services.includes(slug as never)).sort((a, b) => a.data.order - b.data.order);
const allColumns = await getCollection('column');
const columns = allColumns.filter((c) => c.data.services.includes(slug as never));
const others = services.filter((s) => s.slug !== slug);
---
<BaseLayout
  title={metaTitle}
  description={description}
  path={path}
  breadcrumbs={[{ name: 'ご相談内容', path: '/services/' }, { name: svc.name, path }]}
  jsonLd={[serviceLd({ name: svc.name, description, path, areaServed })]}
>
  <PageHeader eyebrow="ご相談内容" title={title} lead={lead}>
    <div class="concern-box">
      <p class="concern-box__title">このようなお悩みはありませんか？</p>
      <ul class="check-list">{svc.concerns.map((c) => <li>{c}</li>)}</ul>
    </div>
  </PageHeader>

  <slot />

  <section class="section section--tint" aria-labelledby="flow-title">
    <div class="container">
      <SectionHead en="Flow" title="ご相談の流れ" id="flow-title" lead="ご依頼の前に、費用のお見積りをお伝えします。お見積りまでは費用はかかりません。" />
      <FlowSteps example={svc.flowExample} />
      <p class="more-link"><a href={u('/fees/')}>料金の目安を見る</a></p>
    </div>
  </section>

  {cases.length > 0 && (
    <section class="section" aria-labelledby="cases-title">
      <div class="container">
        <SectionHead en="Case studies" title="関連する事例" id="cases-title" />
        <div class="case-grid">{cases.map((c) => <CaseCard entry={c} compact />)}</div>
        <p class="more-link"><a href={u('/cases/')}>事例の一覧を見る</a></p>
      </div>
    </section>
  )}

  {columns.length > 0 && (
    <section class="section section--tint" aria-labelledby="columns-title">
      <div class="container">
        <SectionHead en="Column" title="関連するコラム" id="columns-title" />
        <div class="column-grid">{columns.map((c) => <ColumnCard entry={c} />)}</div>
        <p class="more-link"><a href={u('/column/')}>コラムの一覧を見る</a></p>
      </div>
    </section>
  )}

  <section class="section section--white" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <SectionHead en="FAQ" title="よくあるご質問" id="faq-title" />
      <FaqList items={faqs} />
      <p class="more-link"><a href={u('/faq/')}>よくあるご質問の一覧を見る</a></p>
    </div>
  </section>

  <section class="section" aria-label="担当する専門家とほかのご相談内容">
    <div class="container">
      <ProfileBox text={profileText} />
      <nav class="other-services" aria-labelledby="others-title">
        <h2 class="other-services__title" id="others-title">ほかのご相談内容</h2>
        <ul class="other-services__list">
          {others.map((s) => <li><a href={u(`/services/${s.slug}/`)}>{s.name}</a></li>)}
          <li><a href={u('/services/')}>ご相談内容の一覧</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
