---
// トップページ（C2案の本体）と、比較用ページ（pages/compare/）の共通レイアウト。
// 比較用ページの切り替えバーは、CompareLayout が slot="before" で差し込む（本体のトップには出ない）。TopLayout と同じ共通部品（ヘッダー・フッター・SP固定ボタン）を使い、
// スタイルだけ styles/top-ab.css に分けている。公開中のトップ（TopLayout・top.css）には影響しない。
// title・description・構造化データは、公開中のトップと同じ内容を各案のページから渡している（変更なし）。
import '../styles/d7/vars.css';
import '../styles/d7/fonts.css';
import '../styles/top-ab.css';
import '../styles/d7/shell.css';
import SeoHead from '../components/SeoHead.astro';
import PreviewBanner from '../components/d7/PreviewBanner.astro';
import SiteHeader from '../components/d7/SiteHeader.astro';
import SiteFooter from '../components/d7/SiteFooter.astro';
import SpBar from '../components/d7/SpBar.astro';
import ShellScript from '../components/d7/ShellScript.astro';
import { u } from '../lib/url';

interface Props {
  title: string;
  fullTitle?: string;
  description: string;
  path: string;
  variant: 'a' | 'b' | 'c' | 'c2';
  jsonLd?: object[];
}

const { path, variant, ...seo } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <SeoHead path={path} {...seo}>
    <script is:inline>(function(d){d.classList.add('js');var go=function(){d.classList.add('anim-go')},ready=function(){requestAnimationFrame(function(){requestAnimationFrame(go)})};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready();setTimeout(go,3000)})(document.documentElement);</script>
  </SeoHead>
</head>
<body class={`ab ab--${variant}`}>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <PreviewBanner />
  <slot name="before" />
  <SiteHeader path={path} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
  <SpBar />
  <ShellScript />
</body>
</html>
