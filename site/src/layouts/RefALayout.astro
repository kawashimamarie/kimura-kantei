---
// 【比較用・公開しない】参考サイト重視案（R-A）専用レイアウト。C2案（TopLayoutAB・top-ab.css・d7/shell.css）とは共通部品も CSS も共有しない。
// pages/compare/ 配下から使い、確認用ビルド（build:pages）では pages/compare/ ごと出力から外れる。
import '../styles/d7/vars.css';
import '../styles/d7/fonts.css';
import '../styles/ref-a.css';
import SeoHead from '../components/SeoHead.astro';
import { site, contact, nav, company } from '../data/site';
import { services } from '../data/services';
import { u as baseU } from '../lib/url';

// R-A確認用プレビューを単独で公開するビルド（RA_PREVIEW=1）では、比較用バーを出さず、まだ作っていない下層ページへのリンクを
// 「確認用プレビューです」の案内に置き換える（仮のページは作らない）。
const standalone = process.env.RA_PREVIEW === '1';
// 未制作の下層ページへの項目は、リンクにしない（<span class="nl">）。クリック・タップ・キーボードのどれでも何も起きない。
const Lk = standalone ? 'span' : 'a';
const lk = (path: string, cls?: string) => (standalone ? { class: [cls, 'nl'].filter(Boolean).join(' ') } : { href: baseU(path), class: cls });
const u = baseU;

interface Props {
  title: string;
  fullTitle?: string;
  description: string;
  path: string;
  jsonLd?: object[];
}
const { path, ...seo } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <SeoHead path={path} {...seo}>
    <script is:inline>(function(d){d.classList.add('js');var go=function(){d.classList.add('anim-go')},ready=function(){requestAnimationFrame(function(){requestAnimationFrame(go)})};if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',ready);else ready();setTimeout(go,3000)})(document.documentElement);</script>
  </SeoHead>
</head>
<body class="ra">
  <a class="ra-skip" href="#main">本文へスキップ</a>
  {!standalone && <aside class="ra-cmp" aria-label="比較用の表示（公開しない）"><span>比較用</span><Lk {...lk('/compare/c2/')}>C2案</Lk><Lk {...lk('/compare/ref-a/')} aria-current="page">参考サイト重視案（R-A）</Lk></aside>}

  <div class="ra-scrim" aria-hidden="true"></div>
  <header class="ra-hd" id="top">
    <div class="ra-hd__in">
      <a class="ra-brand" href={standalone ? '#top' : baseU('/compare/ref-a/')} aria-label={`${site.name} トップ`}>
        <img src={baseU('/assets/img/logo/kimura-logo-transparent.png')} width="230" height="168" alt="">
        <span class="ra-brand__t"><b>{site.name}</b><small>{site.tagline}</small></span>
      </a>
      <nav class="ra-nav" id="ra-nav" aria-label="メインメニュー">
        <ul>
          {nav.slice(0, 5).map((n) => <li><Lk {...lk(n.href)}>{n.label}</Lk></li>)}
          <li class="ra-nav__only-sp"><Lk {...lk('/fees/')}>料金</Lk></li>
          <li class="ra-nav__only-sp"><Lk {...lk('/faq/')}>よくある質問</Lk></li>
        </ul>
        <div class="ra-nav__cta">
          <a class="ra-nav__tel" href={contact.telHref}><small>お電話</small><b>{contact.tel}</b></a>
          <Lk {...lk('/contact/','ra-nav__mail')}><b>ご相談の予約</b></Lk>
        </div>
      </nav>
      <button class="ra-burger" type="button" aria-expanded="false" aria-controls="ra-nav"><span class="ra-burger__bars" aria-hidden="true"></span><span class="ra-sr">メニュー</span></button>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="ra-ft">
    <div class="ra-ft__in">
      <p class="ra-ft__brand"><img src={baseU('/assets/img/logo/kimura-logo-transparent.png')} width="230" height="168" alt="" loading="lazy"><b>{site.name}</b><small>{site.tagline}</small></p>
      <div class="ra-ft__cols">
        <ul><li><a href={standalone ? '#top' : baseU('/compare/ref-a/')}>TOP</a></li><li><Lk {...lk('/cases/')}>事例</Lk></li><li><Lk {...lk('/column/')}>コラム</Lk></li></ul>
        <ul><li class="h">ご相談内容</li>{services.map((s) => <li class="sub"><Lk {...lk(`/services/${s.slug}/`)}>{s.name}</Lk></li>)}</ul>
        <ul><li class="h">会社案内</li><li class="sub"><Lk {...lk('/profile/')}>代表紹介</Lk></li><li class="sub"><Lk {...lk('/about/')}>会社概要</Lk></li><li class="sub"><Lk {...lk('/fees/')}>料金の目安</Lk></li><li class="sub"><Lk {...lk('/faq/')}>よくある質問</Lk></li></ul>
        <ul><li><Lk {...lk('/contact/')}>お問い合わせ</Lk></li><li><Lk {...lk('/privacy/')}>個人情報保護方針</Lk></li></ul>
      </div>
      <address><b>{site.name}</b><br>〒{contact.postalCode}<br>{contact.address}<br>TEL：{contact.tel}　FAX：{contact.fax}<br>{contact.access}</address>
    </div>
    <p class="ra-ft__copy"><small>© {site.name}</small><small>{company.licenses[0]}</small></p>
  </footer>

  <nav class="ra-bar" aria-label="お問い合わせ"><a class="t" href={contact.telHref}>電話で相談</a><Lk {...lk('/contact/','m')}>相談を予約</Lk></nav>

  <script is:inline>
  (function(){
    if (window.CSS && CSS.supports && CSS.supports('word-break','auto-phrase')) { document.querySelectorAll('wbr').forEach(function(w){w.remove()}); document.body.normalize(); }
    /* メニュー：開閉とも CSS の transition。ここでは状態（aria-expanded・html.ra-open）とフォーカスだけを扱う */
    var html=document.documentElement,b=document.querySelector('.ra-burger'),n=document.getElementById('ra-nav'),sc=document.querySelector('.ra-scrim'),lbl=b&&b.querySelector('.ra-sr');
    if(b&&n){
      var wide=window.matchMedia('(min-width: 1024px)'),isOpen=false;
      var setMenu=function(o,returnFocus,focusIn){
        if(o===isOpen)return;isOpen=o;
        b.setAttribute('aria-expanded',o?'true':'false');html.classList.toggle('ra-open',o);
        if(lbl)lbl.textContent=o?'メニューを閉じる':'メニュー';
        if(o&&focusIn){var f=n.querySelector('a');if(f)requestAnimationFrame(function(){if(isOpen)f.focus({preventScroll:true})})}
        else if(returnFocus){b.focus({preventScroll:true})}
      };
      b.addEventListener('click',function(e){setMenu(!isOpen,true,e.detail===0)}); /* キーボードで開いたときだけ、先頭のリンクへフォーカスを移す（タップ・クリックではフォーカス枠を出さない） */
      if(sc)sc.addEventListener('click',function(){setMenu(false,true)});
      n.addEventListener('click',function(e){if(e.target.closest('a'))setMenu(false,false)});
      document.addEventListener('keydown',function(e){
        if(!isOpen)return;
        if(e.key==='Escape'){setMenu(false,true);return}
        if(e.key==='Tab'){ /* 開いている間は、メニューのリンクと開閉ボタンの間でフォーカスを回す */
          var list=[].slice.call(n.querySelectorAll('a')).concat(b),k=list.indexOf(document.activeElement);
          if(e.shiftKey){if(k<=0){e.preventDefault();list[list.length-1].focus()}}
          else if(k===-1||k===list.length-1){e.preventDefault();list[0].focus()}
        }
      });
      var onWide=function(){if(wide.matches)setMenu(false,false)};
      if(wide.addEventListener)wide.addEventListener('change',onWide);else if(wide.addListener)wide.addListener(onWide);
      window.addEventListener('pageshow',function(e){if(e.persisted)setMenu(false,false)});
    }
    /* スクロールで現れる動き：IntersectionObserver が使え、動きを減らす設定でないときだけ有効にする（html.ra-anim）。
       すでに画面内・画面より上にある要素は動かさずに表示し、画面の下にある要素だけを、近づいたときに表示する。 */
    var items=[].slice.call(document.querySelectorAll('.rv,.rv-img,.rv-bg'));
    if(!items.length||!('IntersectionObserver' in window)||(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches))return;
    var vh=window.innerHeight||html.clientHeight,below=[];
    items.forEach(function(e){if(e.getBoundingClientRect().top<vh*0.92)e.classList.add('in');else below.push(e)});
    html.classList.add('ra-anim');
    var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{rootMargin:'0px 0px -8% 0px'});
    below.forEach(function(e){io.observe(e)});
    setTimeout(function(){below.forEach(function(e){e.classList.add('in')})},12000); /* 念のため：何らかの理由で監視が働かなくても、内容は必ず表示する */
  })();
  </script>
</body>
</html>
