---
// トップページ専用のレイアウト。ヘッダー・フッター・SP固定ボタン・スクリプトは、下層ページと同じ共通部品（components/d7）を使う。
// トップのスタイル（ファーストビューや各セクション）は styles/top.css に分けてあり、下層ページには読み込まれない。
import '../styles/d7/vars.css';
import '../styles/top.css';
import '../styles/d7/shell.css';
import SeoHead from '../components/SeoHead.astro';
import PreviewBanner from '../components/d7/PreviewBanner.astro';
import SiteHeader from '../components/d7/SiteHeader.astro';
import SiteFooter from '../components/d7/SiteFooter.astro';
import SpBar from '../components/d7/SpBar.astro';
import ShellScript from '../components/d7/ShellScript.astro';
import { u } from '../lib/url';

interface Props {
  title: string;
  fullTitle?: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: object[];
}

const { path, ...seo } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <SeoHead path={path} {...seo}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho+B1:wght@600;700;800&display=swap">
    <link rel="preload" as="image" type="image/avif" href={u('/assets/img/top/mv-pc-1080.avif')} media="(min-width: 768px)">
    <link rel="preload" as="image" type="image/avif" href={u('/assets/img/top/mv-sp-780.avif')} media="(max-width: 767px)">
    <script is:inline>document.documentElement.classList.add('js');</script>
  </SeoHead>
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <PreviewBanner />
  <SiteHeader path={path} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
  <SpBar />
  <ShellScript />
</body>
</html>
