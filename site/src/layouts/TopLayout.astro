---
// トップページ専用のレイアウト。ヘッダー・フッター・SP固定ボタンも専用のものを使う。
// 下層ページは BaseLayout（global.css）のまま。トップのスタイルは styles/top.css に分けてあり、下層ページには読み込まれない。
import '../styles/top.css';
import SeoHead from '../components/SeoHead.astro';
import TopHeader from '../components/TopHeader.astro';
import TopFooter from '../components/TopFooter.astro';
import { u } from '../lib/url';

interface Props {
  title: string;
  fullTitle?: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  jsonLd?: object[];
}

const { path, ...seo } = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
  <SeoHead path={path} {...seo}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho+B1:wght@600;700;800&display=swap">
    <link rel="preload" as="image" type="image/avif" href={u('/assets/img/top/mv-pc-1080.avif')} media="(min-width: 768px)">
    <link rel="preload" as="image" type="image/avif" href={u('/assets/img/top/mv-sp-780.avif')} media="(max-width: 767px)">
    <script is:inline>document.documentElement.classList.add('js');</script>
  </SeoHead>
</head>
<body>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <TopHeader path={path} />
  <main id="main">
    <slot />
  </main>
  <TopFooter />
  <nav class="spbar" aria-label="お問い合わせ">
    <a class="spbar__tel" href="tel:0353569158"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>電話</a>
    <a class="spbar__main" href={u('/contact/')}>相談を申し込む</a>
  </nav>
  <script is:inline>
    (function () {
      // スクロール表示：画面に入った要素に is-in を付けるだけ。対応していない環境・動きを減らす設定ではすべて表示する
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (el) { el.classList.add('is-in'); });
      } else {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        els.forEach(function (el) { io.observe(el); });
      }

      // ヘッダーの MENU（1199px以下）：開閉・Esc で閉じる・リンク選択で閉じる・PC幅に戻ったらリセット
      var btn = document.querySelector('.menu');
      var panel = document.getElementById('global-nav');
      if (btn && panel) {
        var label = btn.querySelector('.menu__label');
        var setOpen = function (open) {
          btn.setAttribute('aria-expanded', String(open));
          panel.classList.toggle('is-open', open);
          if (label) label.textContent = open ? '閉じる' : 'MENU';
        };
        btn.addEventListener('click', function () { setOpen(btn.getAttribute('aria-expanded') !== 'true'); });
        panel.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
        });
        document.addEventListener('click', function (e) {
          if (btn.getAttribute('aria-expanded') === 'true' && !e.target.closest('.hd')) setOpen(false);
        });
        var mq = matchMedia('(min-width: 1200px)');
        if (mq.addEventListener) mq.addEventListener('change', function () { if (mq.matches) setOpen(false); });
      }

      // フッターの年
      var y = document.querySelector('[data-year]');
      if (y) y.textContent = String(new Date().getFullYear());
    })();
  </script>
</body>
</html>
