---
// 遺産分割の4つの方法を、家・人物・お金のイラストで示す図（SVG・オリジナル）
interface Props { type: 'genbutsu' | 'daisho' | 'kanka' | 'kyoyu'; label: string }
const { type, label } = Astro.props;
const T = '#2f5a5e', S = '#b5793a', INK = '#4b5255';
const person = (x: number, y: number, c: string, name: string) => `
  <circle cx="${x}" cy="${y - 10}" r="10" fill="${c}"/>
  <path d="M${x - 16} ${y + 18} q0-18 16-18 q16 0 16 18z" fill="${c}"/>
  <text x="${x}" y="${y + 36}" text-anchor="middle" font-size="16" font-weight="700" fill="${INK}">${name}</text>`;
const house = (x: number, y: number, split = false) => `
  <path d="M${x - 26} ${y - 2} L${x} ${y - 24} L${x + 26} ${y - 2} Z" fill="#b9a487"/>
  ${split
    ? `<rect x="${x - 21}" y="${y - 3}" width="21" height="28" fill="${T}" opacity=".85"/><rect x="${x}" y="${y - 3}" width="21" height="28" fill="${S}" opacity=".85"/>`
    : `<rect x="${x - 21}" y="${y - 3}" width="42" height="28" fill="#efe7da" stroke="#b9a487" stroke-width="1.5"/><rect x="${x - 5}" y="${y + 9}" width="10" height="16" fill="#a1866a"/>`}`;
const coin = (x: number, y: number) => `
  <circle cx="${x}" cy="${y}" r="14" fill="#f1dcb4" stroke="${S}" stroke-width="2"/>
  <text x="${x}" y="${y + 5}" text-anchor="middle" font-size="14" font-weight="700" fill="${S}">¥</text>`;
const arrow = (x1: number, y1: number, x2: number, y2: number, text = '', tx = (x1 + x2) / 2, ty = (y1 + y2) / 2 - 7) => `
  <line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${INK}" stroke-width="2" marker-end="url(#ah-${type})"/>
  ${text ? `<text x="${tx}" y="${ty}" text-anchor="middle" font-size="14" fill="${INK}">${text}</text>` : ''}`;
const cap = (x: number, y: number, text: string) => `<text x="${x}" y="${y}" text-anchor="middle" font-size="14" fill="${INK}">${text}</text>`;

const body = {
  genbutsu: `${house(60, 38)}${cap(60, 78, '実家')}${coin(60, 108)}${cap(60, 138, '預貯金')}
    ${arrow(92, 40, 196, 40)}${arrow(80, 108, 196, 108)}
    ${person(232, 34, T, '兄')}${person(232, 104, S, '妹')}`,
  daisho: `${house(44, 60)}${cap(44, 100, '実家')}${arrow(74, 62, 120, 62)}
    ${person(150, 56, T, '兄')}${arrow(176, 62, 226, 62)}${coin(201, 96)}${cap(201, 128, '代償金')}
    ${person(256, 56, S, '妹')}`,
  kanka: `${house(40, 64)}${cap(40, 104, '実家')}${arrow(70, 66, 118, 66, '売却', 94, 56)}
    ${coin(140, 66)}${cap(140, 98, '売却代金')}
    ${arrow(158, 58, 214, 38)}${arrow(158, 74, 214, 100)}
    ${person(244, 34, T, '兄')}${person(244, 104, S, '妹')}`,
  kyoyu: `${house(80, 66, true)}${cap(80, 106, '実家（共有）')}
    ${arrow(108, 58, 206, 38, '持ち分', 150, 38)}${arrow(108, 76, 206, 100, '持ち分', 168, 112)}
    ${person(240, 34, T, '兄')}${person(240, 104, S, '妹')}`,
}[type];
---
<svg class="method-svg" viewBox="0 0 300 150" role="img" aria-label={label}>
  <defs>
    <marker id={`ah-${type}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" fill={INK} />
    </marker>
  </defs>
  <Fragment set:html={body} />
</svg>

<style>
  .method-svg { display: block; width: 100%; max-width: 320px; height: auto; margin: 0 auto; }
</style>
